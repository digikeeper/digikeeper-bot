# Copy to .env for local development, or export these in your environment.
# .env is optional; the variables below are read from the real environment.

# --- Common ---
ENVIRONMENT_NAME=dev
COMMON_TIMEOUT=5s
# Required: host/port the bot binds to locally.
LOCAL_HOST=localhost
LOCAL_PORT=8080

# --- Telegram ---
TELEGRAM_BOT_PUBLIC_URL=your_public_url_or_localhost
TELEGRAM_BOT_TOKEN_FILE=./deployment/tmp/secrets/telegram_token
TELEGRAM_WEB_HOOK_SECRET_TOKEN=

# --- Session ---
SESSION_EXPIRES_AFTER=24h

SQLITE_PATH=./sessions.db
